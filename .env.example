# Copy to .env and fill in (never commit .env)

# Freesound API token — https://freesound.org/apiv2/apply
FREESOUND_API_KEY=

# Local LLM (Ollama) — default model for descriptions / metadata / autopilot text
# OLLAMA_MODEL=qwen3.5:9b

# Optional cloud fallbacks (autopilot / gen-metadata)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=