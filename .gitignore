# Outputs (too large for git)
output/*.mp4
output/*.mp3
output/*.aac
output/*.wav
output/*.jpg
output/*-upload.json
assets/fog_loop.mp4
__pycache__/
.cache/
datasets/
*.pyc

# Source assets (copyright risk + size)
audio/queue/*
audio/used/*
audio/*.mp3
!audio/samples/*.mp3
audio/samples/raw/
audio/*.wav
audio/*.flac
audio/previews/*
!audio/previews/.gitkeep
images/queue/*
images/used/*

# Keep folder structure markers
!audio/.gitkeep
!audio/queue/.gitkeep
!audio/used/.gitkeep
!images/.gitkeep
!images/queue/.gitkeep
!images/used/.gitkeep
!output/.gitkeep
!descriptions/.gitkeep

# Descriptions are personal — keep template only
descriptions/*.txt
!descriptions/template.txt

# OAuth credentials (NEVER commit)
client_secrets.json
*.token
.env
.env.local

# OS junk
.DS_Store
Thumbs.db
*.swp
*~

# Logs
*.log

# Scheduler state (per-machine)
.schedule_state
.batch_state

# Personal queue (keep example only)
queue.csv
